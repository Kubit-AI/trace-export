{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-data-export:otel-record:1.0.0",
  "title": "Agent trace export OTLP JSONL record v1.0.0",
  "description": "One converted database row per JSONL line. A line is not necessarily a complete trace. Empty AnyValue represents a retained source null. GenAI attributes are optional.",
  "type": "object",
  "properties": {
    "resourceSpans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceSpans"
      }
    }
  },
  "required": [
    "resourceSpans"
  ],
  "additionalProperties": false,
  "$defs": {
    "anyValue": {
      "type": "object",
      "properties": {
        "stringValue": {
          "type": "string"
        },
        "boolValue": {
          "type": "boolean"
        },
        "intValue": {
          "type": "string",
          "pattern": "^(?:(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)|-(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7]|9223372036854775808))$"
        },
        "doubleValue": {
          "type": "number"
        },
        "bytesValue": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "arrayValue": {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/anyValue"
              }
            }
          },
          "required": [
            "values"
          ],
          "additionalProperties": false
        },
        "kvlistValue": {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/keyValue"
              }
            }
          },
          "required": [
            "values"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false,
      "maxProperties": 1
    },
    "keyValue": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/anyValue"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyValue"
          }
        },
        "droppedAttributesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyValue"
          }
        },
        "droppedAttributesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "timeUnixNano": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "name": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyValue"
          }
        },
        "droppedAttributesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "timeUnixNano",
        "name"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-fA-F]{32}$"
        },
        "spanId": {
          "type": "string",
          "pattern": "^(?!0{16})[0-9a-fA-F]{16}"
        },
        "traceState": {
          "type": "string"
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyValue"
          }
        },
        "droppedAttributesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "traceId",
        "spanId"
      ],
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-fA-F]{32}$"
        },
        "spanId": {
          "type": "string",
          "pattern": "^(?!0{16})[0-9a-fA-F]{16}"
        },
        "parentSpanId": {
          "type": "string",
          "pattern": "^(?!0{16})[0-9a-fA-F]{16}"
        },
        "traceState": {
          "type": "string"
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "startTimeUnixNano": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "endTimeUnixNano": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyValue"
          }
        },
        "droppedAttributesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "droppedEventsCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "droppedLinksCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "status": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "message": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "traceId",
        "spanId",
        "name",
        "startTimeUnixNano",
        "endTimeUnixNano"
      ],
      "additionalProperties": false
    },
    "scopeSpans": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "schemaUrl": {
          "type": "string"
        }
      },
      "required": [
        "spans"
      ],
      "additionalProperties": false
    },
    "resourceSpans": {
      "type": "object",
      "properties": {
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "scopeSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scopeSpans"
          }
        },
        "schemaUrl": {
          "type": "string"
        }
      },
      "required": [
        "scopeSpans"
      ],
      "additionalProperties": false
    }
  }
}
