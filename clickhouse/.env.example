# Langfuse v4 ClickHouse HTTP(S) endpoint; keep credentials out of the URL.
CLICKHOUSE_URL=https://clickhouse.example.com:8443
CLICKHOUSE_USER=readonly_user
CLICKHOUSE_PASSWORD=replace-with-your-password
CLICKHOUSE_DB=default
# Optional CA bundle for private HTTPS certificates; verification stays on.
# CLICKHOUSE_CA_CERT=/path/to/ca.crt
